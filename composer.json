{
    "name": "astro-masters/dadata-bundle",
    "description": "DaData bundle for Symfony 8",
    "keywords": ["dadata", "symfony-bundle", "symfony-dadata"],
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/astro-masters/dadata-bundle",
    "support": {
        "source": "https://github.com/astro-masters/dadata-bundle"
    },
    "authors": [
        {
            "name": "Velhron",
            "email": "velhron@gmail.com",
            "role": "Original author"
        },
        {
            "name": "Astro Masters",
            "homepage": "https://github.com/astro-masters",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-kernel": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.5",
        "symfony/framework-bundle": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Velhron\\DadataBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Velhron\\DadataBundle\\Tests\\": "tests"
        }
    }
}
